    "/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Create a job (RECRUITER, needs a company first)",
        "security": [
          {
            "cookieAuth": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Backend Engineer"
                  },
                  "description": {
                    "type": "string",
                    "example": "Build and maintain our REST APIs."
                  },
                  "responsibilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "Design APIs",
                      "Write tests"
                    ]
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "2+ years Node.js"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "example": "Engineering"
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "node.js",
                      "mongodb"
                    ]
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      }
                    },
                    "example": {
                      "city": "Bangalore",
                      "state": "Karnataka",
                      "country": "India"
                    }
                  },
                  "workMode": {
                    "type": "string",
                    "enum": [
                      "REMOTE",
                      "HYBRID",
                      "ONSITE"
                    ],
                    "example": "HYBRID"
                  },
                  "employmentType": {
                    "type": "string",
                    "enum": [
                      "FULL_TIME",
                      "PART_TIME",
                      "CONTRACT",
                      "INTERNSHIP"
                    ],
                    "example": "FULL_TIME"
                  },
                  "experience": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "example": {
                      "min": 2,
                      "max": 5
                    }
                  },
                  "salary": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "currency": {
                        "type": "string"
                      },
                      "period": {
                        "type": "string"
                      },
                      "isDisclosed": {
                        "type": "boolean"
                      }
                    },
                    "example": {
                      "min": 800000,
                      "max": 1400000,
                      "currency": "INR",
                      "period": "YEARLY",
                      "isDisclosed": true
                    }
                  },
                  "openings": {
                    "type": "integer",
                    "example": 2
                  },
                  "screeningQuestions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "question": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean"
                        }
                      }
                    },
                    "example": [
                      {
                        "question": "Years of Node.js experience?",
                        "type": "TEXT",
                        "required": true
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "DRAFT",
                      "ACTIVE"
                    ],
                    "example": "ACTIVE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created"
          },
          "400": {
            "description": "No company yet, or missing fields"
          }
        }
      },
