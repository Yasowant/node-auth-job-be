# Server
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/node_auth

# JWT secrets - generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS origin of your frontend
CLIENT_URL=http://localhost:5173

# Cloudinary (avatar + resume uploads)
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Upstash Redis (required at boot - same tier as MONGO_URI, see
# src/config/redis.js). REST API, so there is no local Docker
# equivalent - create a free database at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=replace_me
UPSTASH_REDIS_REST_TOKEN=replace_me

# Kafka (optional - the app logs a warning and keeps running without
# it, see src/events/producers.js). Leave unset for local dev unless
# you are running a local broker; production uses Aiven over SASL_SSL.
KAFKA_BROKER=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
